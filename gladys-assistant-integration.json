{
  "manifest_version": 1,
  "type": "weather",
  "name": "Météo Suisse / MeteoSwiss",
  "cover_image": "https://raw.githubusercontent.com/valentinhttr/gladys-meteoswiss/main/cover.jpg",
  "description": {
    "en": "Swiss local weather forecasts from MeteoSwiss Open Data.",
    "fr": "Prévisions météo locales suisses issues des données ouvertes de MétéoSuisse."
  },
  "version": "1.2.0",
  "docker_image": "ghcr.io/valentinhttr/gladys-meteoswiss:1.2.0",
  "gladys_version": ">=5.1.0",
  "categories": ["environment"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "about",
      "type": "section",
      "label": {
        "en": "MeteoSwiss",
        "fr": "Météo Suisse"
      },
      "description": {
        "en": "No API key needed. Widgets use your house by default; choose any Swiss town in their settings. First load may take a few minutes. Independent, unofficial integration. Source: MeteoSwiss.",
        "fr": "Aucune clé nécessaire. Par défaut : votre maison ; choisissez une autre localité suisse dans les réglages des widgets. Le premier chargement peut prendre quelques minutes. Intégration indépendante et non officielle. Source : Météo Suisse."
      },
      "links": [
        {
          "url": "https://www.meteosuisse.admin.ch",
          "label": {
            "en": "Météo Suisse (MeteoSwiss)",
            "fr": "Météo Suisse"
          }
        },
        {
          "url": "https://opendatadocs.meteoswiss.ch/e-forecast-data/e4-local-forecast-data",
          "label": {
            "en": "Data source and terms",
            "fr": "Source des données et conditions"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "temperature",
      "label": {
        "en": "Temperature · 24 hours",
        "fr": "Température · 24 heures"
      },
      "description": {
        "en": "Hourly temperature forecast.",
        "fr": "Prévisions horaires de température."
      },
      "icon": "thermometer",
      "settings": [
        {
          "key": "location",
          "type": "string",
          "required": false,
          "label": {
            "en": "Location",
            "fr": "Localité"
          },
          "placeholder": {
            "en": "Genève or 1201",
            "fr": "Genève ou 1201"
          },
          "description": {
            "en": "Town or Swiss postcode. Leave empty to use your house. This overrides the House setting.",
            "fr": "Ville ou NPA suisse. Vide : météo de votre maison. Ce champ est prioritaire sur Maison."
          }
        },
        {
          "key": "house",
          "type": "string",
          "required": false,
          "label": {
            "en": "House",
            "fr": "Maison"
          },
          "description": {
            "en": "House name or selector in Gladys. Leave empty for the first located house.",
            "fr": "Nom ou identifiant de la maison dans Gladys. Vide : première maison localisée."
          }
        }
      ]
    },
    {
      "key": "precipitation",
      "label": {
        "en": "Precipitation · 24 hours",
        "fr": "Précipitations · 24 heures"
      },
      "description": {
        "en": "Hourly precipitation forecast and total.",
        "fr": "Prévisions horaires de précipitations et cumul."
      },
      "icon": "cloud-rain",
      "settings": [
        {
          "key": "location",
          "type": "string",
          "required": false,
          "label": {
            "en": "Location",
            "fr": "Localité"
          },
          "placeholder": {
            "en": "Genève or 1201",
            "fr": "Genève ou 1201"
          },
          "description": {
            "en": "Town or Swiss postcode. Leave empty to use your house. This overrides the House setting.",
            "fr": "Ville ou NPA suisse. Vide : météo de votre maison. Ce champ est prioritaire sur Maison."
          }
        },
        {
          "key": "house",
          "type": "string",
          "required": false,
          "label": {
            "en": "House",
            "fr": "Maison"
          },
          "description": {
            "en": "House name or selector in Gladys. Leave empty for the first located house.",
            "fr": "Nom ou identifiant de la maison dans Gladys. Vide : première maison localisée."
          }
        }
      ]
    },
    {
      "key": "wind",
      "label": {
        "en": "Wind · 24 hours",
        "fr": "Vent · 24 heures"
      },
      "description": {
        "en": "Hourly wind speed and gust forecasts.",
        "fr": "Prévisions horaires de vent et de rafales."
      },
      "icon": "wind",
      "settings": [
        {
          "key": "location",
          "type": "string",
          "required": false,
          "label": {
            "en": "Location",
            "fr": "Localité"
          },
          "placeholder": {
            "en": "Genève or 1201",
            "fr": "Genève ou 1201"
          },
          "description": {
            "en": "Town or Swiss postcode. Leave empty to use your house. This overrides the House setting.",
            "fr": "Ville ou NPA suisse. Vide : météo de votre maison. Ce champ est prioritaire sur Maison."
          }
        },
        {
          "key": "house",
          "type": "string",
          "required": false,
          "label": {
            "en": "House",
            "fr": "Maison"
          },
          "description": {
