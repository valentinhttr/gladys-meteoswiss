  "scene_triggers": [
    {
      "key": "precipitation_expected",
      "label": {
        "en": "Precipitation expected",
        "fr": "Précipitations prévues"
      },
      "description": {
        "en": "Triggers once when the selected forecast threshold is reached. Another event requires a complete forecast window without this risk first.",
        "fr": "Déclenche une fois lorsque le seuil choisi apparaît dans les prévisions. Un nouvel événement nécessite d’abord une période complète sans ce risque."
      },
      "fields": [
        {
          "key": "house",
          "type": "select",
          "source": "houses",
          "label": {
            "en": "House",
            "fr": "Maison"
          },
          "required": false,
          "description": {
            "en": "Leave empty for all located houses.",
            "fr": "Laissez vide pour toutes les maisons localisées."
          }
        },
        {
          "key": "threshold_choice",
          "type": "select",
          "required": true,
          "default": "0.2",
          "label": {
            "en": "Precipitation at or above",
            "fr": "Précipitations supérieures ou égales à"
          },
          "options": [
            {
              "value": "0.2",
              "label": {
                "en": "0.2 mm",
                "fr": "0,2 mm"
              }
            },
            {
              "value": "1",
              "label": {
                "en": "1 mm",
                "fr": "1 mm"
              }
            },
            {
              "value": "2",
              "label": {
                "en": "2 mm",
                "fr": "2 mm"
              }
            },
            {
              "value": "5",
              "label": {
                "en": "5 mm",
                "fr": "5 mm"
              }
            },
            {
              "value": "10",
              "label": {
                "en": "10 mm",
                "fr": "10 mm"
              }
            }
          ],
          "description": {
            "en": "Amount in one hour, including rain and snow.",
            "fr": "Quantité sur une heure, pluie et neige incluses."
          }
        },
        {
          "key": "horizon_choice",
          "type": "select",
          "required": true,
          "default": "6",
          "label": {
            "en": "Forecast window",
            "fr": "Période à surveiller"
          },
          "description": {
            "en": "Includes the current hourly interval. Forecast timestamps mark the end of the hour.",
            "fr": "Inclut l’intervalle horaire en cours. Les dates des prévisions indiquent la fin de l’heure."
          },
          "options": [
            {
              "value": "1",
              "label": {
                "en": "1 hour",
                "fr": "1 heure"
              }
            },
            {
              "value": "3",
              "label": {
                "en": "3 hours",
                "fr": "3 heures"
